# Core API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5100

# Frontend
VITE_API_BASE_URL=http://localhost:5100

# Anthropic connector runtime
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BETA=mcp-client-2025-11-20
ANTHROPIC_MAX_TOKENS=900
ANTHROPIC_TIMEOUT_SECONDS=60

# Agent orchestration
AGENT_RUNTIME_PRIMARY=agent_sdk
AGENT_SESSION_HISTORY=12
AGENT_SYSTEM_PROMPT=You are an MCP orchestration assistant. Prefer direct facts from MCP tool outputs.
AGENT_SKILLS_DIR=backend/agent_skills

# Anthropic Agent SDK runtime
AGENT_SDK_MODEL=claude-sonnet-4-6
AGENT_SDK_MAX_TURNS=12
AGENT_SDK_PERMISSION_MODE=default
AGENT_SDK_SERVER_ALIAS=opencontext
AGENT_SDK_SETTING_SOURCES=
AGENT_SDK_NATIVE_SKILLS_ENABLED=false
AGENT_SDK_SUBAGENT_MODEL=claude-sonnet-4-6
AGENT_SDK_PROMPT_HISTORY_FALLBACK_ENABLED=false
# Auto-approve selected built-ins (toggle + explicit tool list)
AGENT_SDK_AUTO_APPROVE_BUILTINS_ENABLED=false
AGENT_SDK_AUTO_APPROVE_BUILTINS=
# Auto-approve any additional tool names (advanced)
AGENT_SDK_AUTO_APPROVE_TOOLS=
# MCP onboarding control-plane tools (server add/test/verify/disable)
AGENT_SDK_MCP_ONBOARDING_ENABLED=true
AGENT_SDK_DISALLOWED_TOOLS=ToolSearch,AskUserQuestion,WebFetch,WebSearch,TodoWrite,NotebookEdit,TaskOutput,TaskStop,CronCreate,CronDelete,CronList,EnterPlanMode,ExitPlanMode,EnterWorktree,Bash,Read,Write,Edit,Glob,Grep
# When true (default), expose duplicate tool names from different servers as aliased tools in Agent SDK runtime.
AGENT_SDK_DUPLICATE_TOOL_ALIAS_ENABLED=true

# MCP transport defaults
MCP_CONNECT_TIMEOUT_MS=8000
MCP_READ_TIMEOUT_MS=45000
MCP_MAX_RETRIES=2

# Optional: auto-register a default MCP server at backend startup
MCP_DEFAULT_SERVER_AUTO_REGISTER=true
MCP_DEFAULT_SERVER_NAME=opencontext-main
MCP_DEFAULT_SERVER_ENDPOINT=
MCP_DEFAULT_SERVER_DESCRIPTION=OpenContext default MCP server
MCP_DEFAULT_SERVER_ENABLED=true
# JSON object string, e.g. {"Authorization":"Bearer <token>"}
MCP_DEFAULT_SERVER_HEADERS_JSON=
# Optional: register multiple defaults in one shot (JSON array)
# Example:
# MCP_DEFAULT_SERVERS_JSON=[{"name":"opencontext-main","endpoint":"https://opencontext.ngrok.dev/mcp"},{"name":"nyc-opengov","endpoint":"https://opengov.ngrok.dev/mcp","description":"OpenGov Socrata NYC"}]
MCP_DEFAULT_SERVERS_JSON=
